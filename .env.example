OPENAI_API_KEY=your_openai_api_key_here
# Optional: override the model
OPENAI_MODEL=gpt-4o-mini

# Supabase auth. Leave both empty for local tinkering (auth off).
# Set either one before you put this on the internet:
#   SUPABASE_URL        -> verifies tokens signed with the new asymmetric keys (JWKS)
#   SUPABASE_JWT_SECRET -> verifies tokens signed with the legacy shared secret (HS256)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
